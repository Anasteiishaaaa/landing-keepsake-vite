include ../data/index.pug
include ../mixins/index.pug

doctype html
html(lang="en")
  head
    block meta
      meta(charset="utf-8")
      meta(name="viewport" content="width=device-width, initial-scale=1")
    title
      block title
        | Keepsake
    block styles
      link(rel="preconnect" href="https://fonts.googleapis.com")
      link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
      link(href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Open+Sans:wght@300;400;700&family=Oswald:wght@300;400;700&display=swap" rel="stylesheet")
      link(rel="stylesheet" href="/src/styles/main.scss")
  body#top
    include ../includes/svg-sprite.pug
    include ../components/header.pug
    main
      block content
    include ../components/footer.pug
    a.to-top(href="#top" aria-label="Back to top")
      +icon('up', 22)
    block scripts
