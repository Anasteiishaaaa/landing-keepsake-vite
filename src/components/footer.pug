footer#contact.footer
  .wrap
    .footer__top
      .footer__links
        each col in footerColumns
          nav.footer__nav(aria-label=col.title)
            h2.footer__title= col.title
            ul.footer__list
              each link in col.links
                li.footer__item
                  a.footer__link(href=link.href)= link.label
      #subscribe.newsletter
        h2.footer__title Newsletter
        p.newsletter__text Fresh case studies and design notes, once a month.
        p#done.newsletter__ok(role="status")
          +icon('check-circle')
          | You’re in! Check your inbox to confirm.
        form.newsletter__form(action="#done" method="get")
          .newsletter__row
            label.sr-only(for="email") Email address
            input#email.newsletter__input(type="email" name="email" placeholder="Your email address" required aria-describedby="email-err")
            +btn('Subscribe')
            p#email-err.newsletter__err Please enter a valid email address.
          label.newsletter__agree
            input(type="checkbox" required)
            |  I agree to the privacy policy
    .footer__bottom
      p © 2026 Keepsake. All rights reserved.
      ul.social
        each item in socials
          li
            a.social__link(href=item.href aria-label=item.label class=`social__link--${item.modifier}`)= item.text
