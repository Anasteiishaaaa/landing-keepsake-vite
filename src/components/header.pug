header.header
  .wrap.header__bar
    input#nav-toggle.header__toggle(type="checkbox" aria-label="Toggle menu")
    a.logo(href="#top" aria-label="Keepsake home")
      b.logo__mark K
      | eepsake
    label.burger(for="nav-toggle" aria-hidden="true")
      i.burger__line
    nav.nav(aria-label="Main")
      ul.nav__list
        each item in navItems
          li.nav__item
            a.nav__link(href=item.href class={ 'nav__link--active': item.active })= item.label
      a.header__fav(href="#subscribe" aria-label="Favourites")
        +icon('heart', 16)
      .nav__extra
        +btn('Contact us', '#contact')
          +icon('mail', 16)
        +btn('Favourites', '#top', 'ghost')
          +icon('heart', 14)(class="u-red")
        .nav__say
          p.nav__cap= contactInfo.caption
          p= contactInfo.email
          p= contactInfo.phone
