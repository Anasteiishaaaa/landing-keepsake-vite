section#works.section(aria-labelledby="works-h")
  .wrap.filter
    each cat in filterCategories
      input.filter__radio(type="radio" name="f" id=cat.id checked=cat.checked)
    .works-head
      +section-head("Our awesome works", "works-h")
      .chips(role="group" aria-label="Filter works")
        each cat in filterCategories
          label.chips__item(for=cat.id)= cat.label
    .works-grid
      each work in works
        +work-card(work)
    .works-more
      +btn("Load more works", "#works", "ghost")
